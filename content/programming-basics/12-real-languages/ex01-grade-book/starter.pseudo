FUNCTION grade(score)
    # 90+ A, 80+ B, 70+ C, 60+ D, otherwise F
    RETURN "?"
END FUNCTION

count = TO_NUMBER(INPUT("How many students? "))
students = []
FOR i FROM 1 TO count DO
    name = INPUT("Name: ")
    score = TO_NUMBER(INPUT("Score: "))
    APPEND(students, {"name": name, "score": score})
END FOR

# show "<name>: <grade>" for each student
# then the class average and the top student
